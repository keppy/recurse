# Copy to .env and fill in. .env is gitignored.

# Required for real runs (python recurse.py run). Not needed for --offline.
ANTHROPIC_API_KEY=

# Model used for all three calls (plan / draw / reflect). Default: claude-sonnet-5
# RECURSE_MODEL=claude-sonnet-5

# Only if DejaVu fonts live somewhere unusual (the standard Linux / macOS / Windows font dirs are searched).
# RECURSE_FONT_DIR=
